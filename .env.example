ANTHROPIC_API_KEY=sk-ant-dein-key-hier
# HF_TOKEN NICHT hier eintragen: pydantic-settings validiert .env strikt gegen
# das Settings-Schema, unbekannte Keys werfen extra_forbidden -- auch fuer
# Secrets, die dabei im Klartext in der Fehlermeldung landen. Noetig fuer den
# privaten Reranker (VoidFloat/chrono24-faq-reranker, siehe README Deployment)
# nur im Rollback-Pfad (USE_LLM_RERANKER=false) -- als echte Env-Var setzen,
# nicht in .env.
